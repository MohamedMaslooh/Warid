{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warid",
  "version": "1.1.4",
  "identifier": "com.maslooh.warid",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "وارِد | Warid",
        "label": "main",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "title": "Warid Control",
        "label": "overlay",
        "url": "index.html?overlay",
        "width": 460,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com https://openrouter.ai https://api.groq.com https://fonts.googleapis.com https://fonts.gstatic.com https://api.github.com https://github.com https://*.githubusercontent.com https://objects.githubusercontent.com; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mohamedmaslooh/Warid/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCMjA4REU1RTc2NzVGRDUKUldUVlgyZm41WTBnKzlkQkhxUUN2TzBpNjlwbmFkMEV3d0dBYXViL01ZaVQyMlJwSStmYmUvU3cK"
    }
  }
}
