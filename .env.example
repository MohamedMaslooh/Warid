# Warid Cloud (paid tier) — local/personal build configuration.
#
# Copy this file to `.env.local` (gitignored) to enable the hosted "Warid Cloud"
# tier in your local build. Leave it absent for the public BYOK-only build:
# without VITE_CLOUD_ENABLED=true, no cloud UI or code path is reachable.

# Turn the cloud tier on for this build.
VITE_CLOUD_ENABLED=true

# Warid Cloud gateway (Cloudflare Worker). Use the workers.dev URL while testing,
# then your custom domain (e.g. https://api.warid.app) for launch.
VITE_CLOUD_GATEWAY_URL=https://warid-cloud.<your-subdomain>.workers.dev

# Supabase project (auth + accounts). From Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
